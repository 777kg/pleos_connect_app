<?xml version="1.0" encoding="utf-8"?>
<!-- 확인 대화상자 면: 흰 면 + 회색 테두리, 바깥 여백으로 화면 가장자리와 띄웁니다. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/background_primary" />
        <stroke android:width="1dp" android:color="@color/outline" />
        <corners android:radius="@dimen/corner_radius" />
    </shape>
</inset>

<?xml version="1.0" encoding="utf-8"?>
<!-- S05 소모품 타일 하나(S05-01~03): 사진(단계 사진, 계산 불가면 흐린 대표 사진) + 이름 + 짧은 상태.
     위치만으로 구분하지 않게 이름을 함께 두고, 타일 폭을 맞춰 Pleos 빠른 설정 타일처럼 정렬합니다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/item_tile_width"
    android:layout_height="wrap_content"
    android:background="@drawable/item_selected_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:minWidth="@dimen/touch_target_min"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/image"
        android:layout_width="@dimen/item_icon_size"
        android:layout_height="@dimen/item_icon_size"
        android:background="@drawable/image_frame"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="@dimen/text_label"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_small" />
</LinearLayout>

    <dimen name="card_padding">20dp</dimen>
    <dimen name="corner_radius">0dp</dimen>

    <dimen name="text_title">36sp</dimen>    <!-- Title Medium -->
    <dimen name="text_key">48sp</dimen>      <!-- Headline Small: 잔여% 같은 핵심 수치 -->

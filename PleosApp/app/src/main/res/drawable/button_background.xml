<?xml version="1.0" encoding="utf-8"?>
<!-- 기본 버튼(기본 앱 세그먼트 버튼): 흰 면 + 얇은 회색 테두리, 각진 모서리.
     선택(이력 탭)은 검정 채움으로 반전하고, 선택 여부는 글자색·접근성 상태로도 함께 전달합니다. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_basic_disabled" />
            <stroke android:width="@dimen/button_stroke" android:color="@color/divider" />
            <corners android:radius="@dimen/corner_radius" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_filled" />
            <stroke android:width="@dimen/button_stroke" android:color="@color/button_filled" />
            <corners android:radius="@dimen/corner_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_basic_pressed" />
            <stroke android:width="@dimen/button_stroke" android:color="@color/outline" />
            <corners android:radius="@dimen/corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_basic" />
            <stroke android:width="@dimen/button_stroke" android:color="@color/outline" />
            <corners android:radius="@dimen/corner_radius" />
        </shape>
    </item>
</selector>

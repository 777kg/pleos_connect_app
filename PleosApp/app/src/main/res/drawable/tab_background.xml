<?xml version="1.0" encoding="utf-8"?>
<!-- S02 항목 탭: 기본 버튼과 같은 모양. 선택 탭은 검정 채움에 더해 아래쪽 흰 막대(4dp)를 그려
     색만으로 선택을 구분하지 않게 합니다(QA-017, UI_SPEC §0 색상·버튼). 글자도 굵게 바꿉니다(코드). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_filled" />
                    <stroke android:width="@dimen/button_stroke" android:color="@color/button_filled" />
                </shape>
            </item>
            <item android:bottom="8dp" android:gravity="bottom|fill_horizontal" android:left="16dp" android:right="16dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/text_on_filled" />
                    <size android:height="@dimen/tab_indicator_height" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@drawable/button_background" />
</selector>
